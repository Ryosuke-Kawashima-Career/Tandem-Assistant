# ==============================================================================
# EchoSphere Tandem Co-Teacher: Environment Configuration Template
# ==============================================================================

# Agora SD-RTN Real-Time Communication Credentials
# NEXT_PUBLIC_AGORA_APP_ID is read by the frontend; AGORA_APP_ID is read by the
# Python backend (src/rtc/agora_client.py, src/rtc/convoai_client.py). Set both.
NEXT_PUBLIC_AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_CERTIFICATE=your_agora_app_certificate_here
AGORA_CHANNEL_NAME=EchoSphere-Tandem-Room-1

# Agora Conversational AI (Convo AI) Engine - REQ-09 / REQ-10
# RESTful API credentials from Agora Console > Developer Toolkit > RESTful API.
# Without these the backend runs Convo AI in simulated mode.
AGORA_CUSTOMER_ID=your_agora_customer_id_here
AGORA_CUSTOMER_SECRET=your_agora_customer_secret_here

# Publicly reachable base URL of this backend, used by the Convo AI Engine to call
# the Custom LLM bridge at <CONVOAI_LLM_BASE_URL>/chat/completions (REQ-11).
# Must be a public URL (e.g. an ngrok tunnel) in live mode - not localhost.
CONVOAI_LLM_BASE_URL=http://localhost:8000

# Start a Convo AI agent even when the Custom LLM bridge above is unreachable. The
# backend normally refuses with a 502 naming the URL, because an agent started against an
# unreachable bridge joins the channel, reports RUNNING, and then never speaks - silence
# with no diagnosis anywhere. Set to 1 only for deliberate offline work.
CONVOAI_SKIP_BRIDGE_PREFLIGHT=

# Convo AI vendor selection. Vendor and voice identifiers change independently of
# this repo - look them up in the current Agora provider matrix before setting.
CONVOAI_ASR_VENDOR=ares
CONVOAI_TTS_VENDOR=microsoft

# Milliseconds of silence before the Engine decides the learner stopped speaking -
# REQ-LAT-05. Documented range [120, 2000]; out-of-range values are clamped.
# The Engine's own default is 640ms, spent before the Custom LLM bridge is called at
# all, so it comes straight out of the reply budget.
# Lower = snappier turn-taking but more risk of cutting a learner off mid-sentence.
# 480 is a deliberate compromise: language learners hesitate mid-sentence much more
# than native speakers, so the 120ms floor is NOT recommended here. Raise it toward
# 640+ if learners report being interrupted while thinking.
CONVOAI_END_OF_SPEECH_SILENCE_MS=480

# Microsoft Azure Speech resource (Azure Portal > your Speech resource > Keys and
# Endpoint). Required by the "microsoft" TTS vendor above; the Convo AI Engine calls
# Azure TTS with these, not your Agora account.
CONVOAI_TTS_KEY=your_azure_speech_key_here
CONVOAI_TTS_REGION=your_azure_speech_region_here

# Voice names per language - look up current names at:
# https://learn.microsoft.com/en-us/azure/ai-services/speech-service/language-support?tabs=tts
CONVOAI_TTS_VOICE_EN=en-US-AvaMultilingualNeural
CONVOAI_TTS_VOICE_JA=ja-JP-NanamiNeural
CONVOAI_TTS_VOICE_HI=hi-IN-SwaraNeural

# Reasoning engine backing TeachingAgent - REQ-LLM-01.
# Supported values: mock | openai | gemini
#   mock   - canned offline replies. No API key needed, no cost, and the agent repeats
#            a small set of fixed phrases. This is the default on purpose.
#   openai - requires OPENAI_API_KEY below.
#   gemini - requires GEMINI_API_KEY below.
# An unset value, a missing/invalid key, or an uninstalled provider SDK falls back to
# `mock` with a warning in the log - the server does not crash. Check the startup line
# `TeachingAgent initialized with engine: '...'` to see what is actually active.
# Opt-in: every spoken turn becomes a billed model call once this is not `mock`.
ECHOSPHERE_ENGINE=mock

# Model tier per provider - REQ-LAT-04. These control reply latency directly: the
# student is waiting in a live voice call, so the defaults are each vendor's current
# lowest-latency conversational tier rather than their strongest model.
#   Faster/cheaper still: gpt-5.4-nano / gemini-3.1-flash-lite - aimed at classification
#   and extraction, so check reply quality before using them for conversation.
#   Stronger but slower to first token: gpt-5.4 / gemini-3.5-flash.
# Model names and their relative speed change independently of this repo - check the
# current provider matrix rather than trusting these values indefinitely.
ECHOSPHERE_OPENAI_MODEL=gpt-5.4-mini
ECHOSPHERE_GEMINI_MODEL=gemini-3.5-flash-lite

# Models for the structured scaffolding call (subtitles, idiom cards, quizzes).
# Deliberately stronger than the voice tiers above: since REQ-LAT-02 this call runs
# concurrently and no longer delays speech, so it does not need the fast tier.
# Do not point these at a flash-lite/nano tier - a live run showed those emit malformed
# JSON for this 5-block schema often enough to lose idiom cards to the fallback.
ECHOSPHERE_OPENAI_SCAFFOLDING_MODEL=gpt-5.4
ECHOSPHERE_GEMINI_SCAFFOLDING_MODEL=gemini-3.5-flash

# Seconds the Custom LLM bridge waits for the engine before speaking a fallback line
# (REQ-LLM-06). Since REQ-LAT-03 this bounds the wait for the *next* streamed token
# rather than for one complete reply, so it catches a stall at any point in the stream.
# Must stay below the Convo AI Engine's idle_timeout (30s), which terminates an agent
# that has produced no activity.
CONVOAI_LLM_TIMEOUT_SECONDS=20

# AI LLM & Speech API Keys
# GEMINI_API_KEY also authenticates the Gemini Live Translate legs (REQ-17). It is
# server-side only and travels in the Live WebSocket URL - never in a message body, and
# never to the browser.
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Gemini Live Translate model (REQ-17). Environment-configured because the Live preview
# lineup moves independently of this repository; check the current provider matrix rather
# than trusting this default indefinitely.
GEMINI_LIVE_TRANSLATE_MODEL=gemini-3.5-live-translate-preview

# Session Artifact Persistence - REQ-15 / REQ-16.
# The local repository is the MVP source of truth: one JSON file per session, holding its
# transcript, notes, and quizzes. Deleting a session is deleting its file.
ECHOSPHERE_DATA_DIR=data/artifacts

# Days to keep a stored session before it is purged at startup. Retention is opt-in -
# leave this empty to keep sessions indefinitely. Silently discarding a record of a real
# conversation is worse than an oversized directory, so there is no default window.
ECHOSPHERE_ARTIFACT_RETENTION_DAYS=

# Optional Notion export (REQ-15). Markdown export always works and needs nothing here;
# these only enable `GET /api/session/artifact/export?format=notion`, which answers 503
# while they are unset. NOTION_PARENT_PAGE_ID is the page new session pages are created
# under, and the integration must be shared with that page in Notion.
# Notion changes API behavior by version header - check their current version before
# overriding NOTION_API_VERSION.
NOTION_API_KEY=
NOTION_PARENT_PAGE_ID=
NOTION_API_VERSION=2022-06-28

# Server & Network Configuration
PORT=8000
HOST=0.0.0.0
# Set to DEBUG to log each inbound Custom LLM request from the Convo AI Engine -
# fields present, message count, resolved user text, and the resolved language plus
# its source (session context vs. request override). See REQ-LLM-04.
LOG_LEVEL=INFO

## Additional Tools
REPORT_EMAIL=""
NOTION_API_KEY=""
NOTION_DATABASE_ID=""
RESEND_API_KEY=""
